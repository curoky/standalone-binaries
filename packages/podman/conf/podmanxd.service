[Unit]
Description=Podman API Service
Requires=podmanxd.socket
After=podmanxd.socket
StartLimitIntervalSec=0

[Service]
Type=exec
User=root
Delegate=yes
KillMode=process
RuntimeDirectory=podman
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart="@PODMANX_ROOT@/bin/podman-server"
ExecStop="@PODMANX_ROOT@/bin/podman" stop --all
Restart=on-failure
RestartSec=5s
